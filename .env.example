# Copy this file to .env and fill in the values. .env is never committed.

# Required: Slack Incoming Webhook URL for daily notifications.
# How to create one is described in docs/SETUP_GUIDE.md.
SLACK_WEBHOOK_URL=

# Only required when config.toml has [llm] backend = "api".
# With the default backend = "claude_code" this stays empty.
ANTHROPIC_API_KEY=
